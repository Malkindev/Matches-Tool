{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/login/?$",
      "dest": "/api/login.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.js?__path=$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}